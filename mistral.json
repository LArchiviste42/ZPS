{
  "schemaVersion": 2,
  "kind": "app",
  "name": "mistral-app",
  "deployment": {
    "organizationId": "200bf19a-d80c-4b34-978d-7399d048d5a2",
    "workspaceId": "6e005cf4-b72f-45b7-83ae-b30a42c58b18",
    "appId": "01a1b516-620c-73fd-be04-011607226bfa"
  },
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/api"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "uv run --all-packages python -m api.dev",
        "preStartCommands": [
          "uv run --all-packages python -m cli pre-start"
        ]
      },
      "deploy": {
        "startCommand": "uv run --frozen --no-dev --no-sync uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20",
        "preStartCommands": [
          "uv run --frozen --no-dev --no-sync python -m cli pre-start"
        ]
      }
    },
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    },
    {
      "type": "managed",
      "name": "postgres",
      "engine": "postgres"
    }
  ]
}
